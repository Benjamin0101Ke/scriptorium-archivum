# Copiar como .env y completar los campos vacios
# Este archivo es una muestra publica y no contiene claves reales
# Los comentarios van en su propia linea para no alterar los valores

# Contrasena del usuario postgres de esta instalacion
POSTGRES_PASSWORD=
# Puerto de PostgreSQL al conectarse desde Windows
POSTGRES_PORT=5433

# Puerto para abrir pgAdmin en el navegador
PGADMIN_PORT=5052
# Correo para iniciar sesion en pgAdmin y no para enviar mensajes
PGADMIN_DEFAULT_EMAIL=admin@scriptorium.dev
# Contrasena para iniciar sesion en pgAdmin
PGADMIN_DEFAULT_PASSWORD=

# true permite enviar correos y false desactiva el envio
# Cambiar a true despues de completar los datos de la cuenta de envio
SMTP_HABILITADO=false
# Servidor de salida de Gmail y puerto con STARTTLS
SMTP_HOST=smtp.gmail.com
# Puerto de salida del servidor de correo
SMTP_PORT=587
# Mantener true para autenticar la cuenta con conexion protegida
SMTP_TLS=true
# Correo de la aplicacion que aparecera como remitente autorizado
# Sustituir el correo de muestra por la cuenta real de la aplicacion
SMTP_FROM=correo-de-la-aplicacion@gmail.com
# Cuenta utilizada para autenticarse en el servidor de correo
SMTP_USER=correo-de-la-aplicacion@gmail.com
# Contrasena de aplicacion del correo y no la clave habitual de Gmail
SMTP_PASSWORD=
# Buzon que recibe avisos de registro y acceso
# Si se deja vacio se utiliza SMTP_FROM
SMTP_AVISOS=
# true incluye avisos de inicio de sesion y false los desactiva
SMTP_AVISOS_ACCESO=true
