        <mxCell id="tbl_recursos_digitales" parent="1" style="swimlane;startSize=44;horizontal=1;rounded=0;collapsible=0;container=1;recursiveResize=0;html=1;whiteSpace=wrap;fontFamily=Georgia;fontSize=22;fontStyle=1;align=center;verticalAlign=middle;fillColor=#F5E6BD;swimlaneFillColor=#FFFFFF;strokeColor=#3A4652;strokeWidth=1.7;" tooltip="CHECK \(\(\(clase\)::text = ANY \(\(ARRAY['PDF'::character varying, 'REF_UES'::character varying, 'ENLACE'::character varying]\)::text[]\)\)\)&#10;CHECK \(\(\(\(clase\)::text = 'ENLACE'::text\) OR \(NOT difusion_habilitada\)\)\)&#10;CHECK \(\(\(\(clase\)::text &lt;&gt; 'ENLACE'::text\) OR \(\(ubicacion ~* '^https://[^[:space:]/?#]+'::text\) AND \(tipo_formato IS NOT NULL\) AND \(\(tipo_formato\)::text ~ '[^[:space:]]'::text\) AND \(descripcion IS NOT NULL\) AND \(descripcion ~ '[^[:space:]]'::text\)\)\)\)&#10;CHECK \(\(\(\(clase\)::text = 'ENLACE'::text\) OR \(id_entrega IS NOT NULL\)\)\)&#10;CHECK \(\(\(\(\(clase\)::text = 'PDF'::text\) AND \(estado_carga IS NOT NULL\) AND \(\(estado_carga\)::text = ANY \(\(ARRAY['Pendiente'::character varying, 'Disponible'::character varying, 'Fallido'::character varying]\)::text[]\)\)\) OR \(\(\(clase\)::text &lt;&gt; 'PDF'::text\) AND \(estado_carga IS NULL\)\)\)\)&#10;CHECK \(\(\(tamano_bytes IS NULL\) OR \(\(\(clase\)::text = 'PDF'::text\) AND \(tamano_bytes &gt; 0\)\)\)\)&#10;CHECK \(\(ubicacion ~ '[^[:space:]]'::text\)\)&#10;FOREIGN KEY \(id_trabajo, id_entrega\) REFERENCES entregas\(id_trabajo, id_entrega\)&#10;FOREIGN KEY \(id_trabajo\) REFERENCES trabajos\(id_trabajo\)&#10;PRIMARY KEY \(id_recurso\)" value="recursos_digitales" vertex="1">
          <mxGeometry height="417" width="620" x="3560" y="300" as="geometry" />
