        <mxCell id="tbl_correos_intentos" parent="1" style="swimlane;startSize=44;horizontal=1;rounded=0;collapsible=0;container=1;recursiveResize=0;html=1;whiteSpace=wrap;fontFamily=Georgia;fontSize=22;fontStyle=1;align=center;verticalAlign=middle;fillColor=#CCE6D1;swimlaneFillColor=#FFFFFF;strokeColor=#3A4652;strokeWidth=1.7;" tooltip="CHECK \(\(\(\(\(categoria\)::text = 'Aviso'::text\) AND \(id_correo IS NOT NULL\) AND \(id_usuario IS NULL\)\) OR \(\(\(categoria\)::text = 'Recuperacion'::text\) AND \(id_correo IS NULL\) AND \(id_usuario IS NOT NULL\)\)\)\)&#10;CHECK \(\(ciclo &gt;= 0\)\)&#10;CHECK \(\(\(numero_intento &gt;= 1\) AND \(numero_intento &lt;= 5\)\)\)&#10;CHECK \(\(\(resultado\)::text = ANY \(\(ARRAY['Enviado'::character varying, 'Fallido'::character varying, 'Omitido'::character varying]\)::text[]\)\)\)&#10;FOREIGN KEY \(id_correo\) REFERENCES correos_eventos\(id_correo\)&#10;FOREIGN KEY \(id_usuario\) REFERENCES usuarios\(id_usuario\)&#10;PRIMARY KEY \(id_intento\)&#10;UNIQUE \(id_correo, ciclo, numero_intento\)" value="correos_intentos" vertex="1">
